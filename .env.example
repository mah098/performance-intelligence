# Copy to .env.local and configure. Keep real values out of version control.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webvitals
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Optional alternative login provider for existing GitHub accounts.
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
PAGESPEED_API_KEY=
CRUX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Base64-encoded 32-byte key. Use a secret manager and rotate with an explicit migration plan.
GITHUB_TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:3000
